<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Rien ne part dans le cloud Google : décision « données locales uniquement ». -->
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <!-- Le transfert direct d'un téléphone à l'autre reste permis. -->
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
