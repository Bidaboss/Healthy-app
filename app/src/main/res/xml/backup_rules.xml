<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 et moins : aucune sauvegarde automatique (les données restent sur le téléphone). -->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
